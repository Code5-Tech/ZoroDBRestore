<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ZoroDBRestore.ViewModels"
             x:DataType="vm:SettingsViewModel"
             x:Class="ZoroDBRestore.Views.SettingsPage"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="24,20">

            <Label Text="Settings" Style="{StaticResource SectionHeading}" />
            <Label Text="Configure tool paths, backup directory, and bundled binaries."
                   TextColor="{StaticResource OnSurfaceMuted}"
                   FontSize="14"
                   Margin="0,0,0,20" />

            <!-- Bundled Tools extraction -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <VerticalStackLayout Spacing="0">

                    <Label Text="Bundled MongoDB Tools"
                           FontSize="15" FontAttributes="Bold"
                           TextColor="{StaticResource OnBackground}"
                           Margin="0,0,0,6" />

                    <Label TextColor="{StaticResource OnSurfaceMuted}"
                           FontSize="13"
                           Margin="0,0,0,10"
                           LineBreakMode="WordWrap">
                        <Label.Text>mongodump and mongorestore are bundled inside the app. Extract them once — no separate installation needed.</Label.Text>
                    </Label>

                    <!-- Status indicator -->
                    <Border Padding="12,8"
                            StrokeShape="RoundRectangle 6"
                            StrokeThickness="1"
                            Margin="0,0,0,10">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding BundledToolsAvailable}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource AlertSuccessBg}" />
                                <Setter Property="Stroke" Value="{StaticResource AlertSuccessBorder}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding BundledToolsAvailable}" Value="False">
                                <Setter Property="BackgroundColor" Value="{StaticResource AlertWarningBg}" />
                                <Setter Property="Stroke" Value="{StaticResource AlertWarningBorder}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="8">
                            <Label FontSize="16" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding BundledToolsAvailable}" Value="True">
                                        <Setter Property="Text" Value="✓" />
                                        <Setter Property="TextColor" Value="{StaticResource AlertSuccessFg}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding BundledToolsAvailable}" Value="False">
                                        <Setter Property="Text" Value="⚠" />
                                        <Setter Property="TextColor" Value="{StaticResource AlertWarningFg}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label FontSize="13" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding BundledToolsAvailable}" Value="True">
                                        <Setter Property="Text" Value="Bundled tools extracted and ready." />
                                        <Setter Property="TextColor" Value="{StaticResource AlertSuccessFg}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding BundledToolsAvailable}" Value="False">
                                        <Setter Property="Text" Value="Tools not yet extracted. Click Extract below." />
                                        <Setter Property="TextColor" Value="{StaticResource AlertWarningFg}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>

                    <Button Text="⬇  Extract Bundled Tools"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ExtractBundledToolsCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            HorizontalOptions="Start"
                            Margin="0,0,0,10" />

                    <ScrollView HeightRequest="100">
                        <Label Text="{Binding ExtractionLog}"
                               Style="{StaticResource LogViewer}" />
                    </ScrollView>

                </VerticalStackLayout>
            </Border>

            <!-- Tool paths -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <VerticalStackLayout Spacing="0">

                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <Label Grid.Column="0"
                               Text="Tool Paths"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource OnBackground}"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="1"
                                Text="Check Availability"
                                Style="{StaticResource OutlineButton}"
                                Command="{Binding CheckToolsCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                    </Grid>

                    <Label Text="MONGODUMP PATH" Style="{StaticResource FieldLabel}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               Text="{Binding MongoDumpPath}"
                               Placeholder="mongodump"
                               Style="{StaticResource FormEntry}" />
                        <Label Grid.Column="1"
                               Text="✓"
                               TextColor="{StaticResource Secondary}"
                               FontSize="18"
                               VerticalOptions="Center"
                               IsVisible="{Binding MongoDumpAvailable}" />
                    </Grid>

                    <Label Text="MONGORESTORE PATH" Style="{StaticResource FieldLabel}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               Text="{Binding MongoRestorePath}"
                               Placeholder="mongorestore"
                               Style="{StaticResource FormEntry}" />
                        <Label Grid.Column="1"
                               Text="✓"
                               TextColor="{StaticResource Secondary}"
                               FontSize="18"
                               VerticalOptions="Center"
                               IsVisible="{Binding MongoRestoreAvailable}" />
                    </Grid>

                    <Label Text="DEFAULT BACKUP DIRECTORY" Style="{StaticResource FieldLabel}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               Text="{Binding DefaultBackupDirectory}"
                               Placeholder="e.g. C:\Backups\MongoDB"
                               Style="{StaticResource FormEntry}" />
                        <Button Grid.Column="1"
                                Text="Browse"
                                Style="{StaticResource OutlineButton}"
                                Command="{Binding BrowseBackupDirectoryCommand}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Save button + status -->
            <HorizontalStackLayout Spacing="16">
                <Button Text="💾  Save Settings"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   VerticalOptions="Center" />
                <Label Text="{Binding StatusMessage}"
                       Style="{StaticResource StatusLabel}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
