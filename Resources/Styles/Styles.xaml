<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<Style TargetType="ActivityIndicator">
		<Setter Property="Color" Value="{StaticResource PrimaryDark}" />
	</Style>

	<Style ApplyToDerivedTypes="True" TargetType="Page">
		<Setter Property="BackgroundColor" Value="{StaticResource Background}" />
	</Style>

	<Style x:Key="PrimaryButton" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{StaticResource PrimaryDark}" />
		<Setter Property="TextColor" Value="White" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Padding" Value="16,10" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="14" />
	</Style>

	<Style x:Key="DangerButton" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
		<Setter Property="TextColor" Value="White" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Padding" Value="16,10" />
		<Setter Property="FontSize" Value="14" />
	</Style>

	<Style x:Key="OutlineButton" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{StaticResource SurfaceElevated}" />
		<Setter Property="TextColor" Value="{StaticResource PrimaryDark}" />
		<Setter Property="BorderColor" Value="{StaticResource PrimaryDark}" />
		<Setter Property="BorderWidth" Value="1.5" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Padding" Value="16,10" />
		<Setter Property="FontSize" Value="14" />
	</Style>

	<Style x:Key="Card" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource SurfaceElevated}" />
		<Setter Property="Stroke" Value="{StaticResource CardBorder}" />
		<Setter Property="StrokeThickness" Value="1.5" />
		<Setter Property="StrokeShape" Value="RoundRectangle 8" />
		<Setter Property="Padding" Value="16" />
		<Setter Property="Shadow">
			<Setter.Value>
				<Shadow
					Brush="#330F172A"
					Opacity="0.35"
					Radius="8"
					Offset="0,2" />
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="FieldLabel" TargetType="Label">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="TextColor" Value="{StaticResource OnSurface}" />
		<Setter Property="Margin" Value="0,8,0,2" />
	</Style>

	<Style x:Key="FormEntry" TargetType="Entry">
		<Setter Property="BackgroundColor" Value="{StaticResource FormFieldBackground}" />
		<Setter Property="TextColor" Value="{StaticResource OnBackground}" />
		<Setter Property="PlaceholderColor" Value="{StaticResource OnSurfaceMuted}" />
		<Setter Property="FontSize" Value="14" />
	</Style>

	<Style TargetType="Picker">
		<Setter Property="BackgroundColor" Value="{StaticResource FormFieldBackground}" />
		<Setter Property="TextColor" Value="{StaticResource OnBackground}" />
		<Setter Property="TitleColor" Value="{StaticResource OnSurfaceMuted}" />
		<Setter Property="FontSize" Value="14" />
	</Style>

	<Style x:Key="SectionHeading" TargetType="Label">
		<Setter Property="FontSize" Value="22" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="TextColor" Value="{StaticResource OnBackground}" />
		<Setter Property="Margin" Value="0,0,0,12" />
	</Style>

	<Style x:Key="LogViewer" TargetType="Label">
		<Setter Property="BackgroundColor" Value="{StaticResource TerminalBackground}" />
		<Setter Property="TextColor" Value="{StaticResource TerminalText}" />
		<Setter Property="FontFamily" Value="OpenSans-Regular" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Padding" Value="12" />
		<Setter Property="LineBreakMode" Value="WordWrap" />
	</Style>

	<Style x:Key="StatusLabel" TargetType="Label">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="TextColor" Value="{StaticResource OnSurface}" />
		<Setter Property="Margin" Value="0,4,0,0" />
	</Style>

	<Style TargetType="Switch">
		<Setter Property="OnColor" Value="{StaticResource PrimaryDark}" />
		<Setter Property="ThumbColor" Value="{StaticResource FormFieldBackground}" />
	</Style>

</ResourceDictionary>
