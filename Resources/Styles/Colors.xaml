<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<!--  Brand  -->
	<Color x:Key="Primary">#3B82F6</Color>
	<Color x:Key="PrimaryDark">#2563EB</Color>
	<Color x:Key="PrimaryLight">#DBEAFE</Color>
	<Color x:Key="Secondary">#22C55E</Color>
	<Color x:Key="Danger">#EF4444</Color>
	<Color x:Key="Warning">#F59E0B</Color>

	<!--  Page vs form fields: page is lighter; inputs keep the slate-blue  -->
	<Color x:Key="Background">#E2E8F0</Color>
	<Color x:Key="FormFieldBackground">#CBD5E1</Color>
	<Color x:Key="Surface">#F8FAFC</Color>
	<Color x:Key="SurfaceElevated">#FFFFFF</Color>
	<Color x:Key="SurfaceVariant">#E2E8F0</Color>
	<Color x:Key="CardBorder">#475569</Color>

	<!--  Text: high contrast on light surfaces  -->
	<Color x:Key="OnBackground">#0F172A</Color>
	<Color x:Key="OnSurface">#1E293B</Color>
	<Color x:Key="OnSurfaceMuted">#475569</Color>
	<Color x:Key="OnDark">#F8FAFC</Color>
	<Color x:Key="OnDarkMuted">#94A3B8</Color>

	<!--  Accent callouts (replacing pale-only info strips)  -->
	<Color x:Key="InfoStripBackground">#1E3A8A</Color>
	<Color x:Key="InfoStripText">#E0E7FF</Color>

	<!--  Alerts & badges  -->
	<Color x:Key="AlertSuccessBg">#166534</Color>
	<Color x:Key="AlertSuccessFg">#DCFCE7</Color>
	<Color x:Key="AlertSuccessBorder">#22C55E</Color>
	<Color x:Key="AlertErrorBg">#991B1B</Color>
	<Color x:Key="AlertErrorFg">#FECACA</Color>
	<Color x:Key="AlertErrorBorder">#EF4444</Color>
	<Color x:Key="AlertWarningBg">#92400E</Color>
	<Color x:Key="AlertWarningFg">#FEF3C7</Color>
	<Color x:Key="AlertWarningBorder">#F59E0B</Color>
	<Color x:Key="AlertInfoBg">#1E3A8A</Color>
	<Color x:Key="AlertInfoFg">#C7D2FE</Color>
	<Color x:Key="AlertInfoBorder">#3B82F6</Color>
	<Color x:Key="BadgeDefaultBg">#1E3A8A</Color>
	<Color x:Key="BadgeDefaultFg">#E0E7FF</Color>
	<Color x:Key="BadgeDefaultBorder">#3B82F6</Color>

	<!--  Terminal  -->
	<Color x:Key="TerminalBackground">#0C0C12</Color>
	<Color x:Key="TerminalText">#E2E8F0</Color>

	<Color x:Key="White">White</Color>
	<Color x:Key="Black">Black</Color>

</ResourceDictionary>
